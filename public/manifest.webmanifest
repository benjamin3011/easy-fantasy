{
  "name": "Easy Fantasy",
  "short_name": "Easy Fantasy",
  "description": "Fantasy Football League Management App",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#465fff",
  "orientation": "portrait-primary",
  "scope": "/",
  "categories": ["sports", "games"],
  "lang": "en-US",
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/icons/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/apple-icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/manifest-icon-192.maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/manifest-icon-192.maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/manifest-icon-512.maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/manifest-icon-512.maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/screenshot-mobile.png",
      "type": "image/png",
      "sizes": "390x844",
      "form_factor": "narrow",
      "label": "Fantasy dashboard on mobile"
    },
    {
      "src": "/images/screenshot-desktop.png", 
      "type": "image/png",
      "sizes": "1920x1080",
      "form_factor": "wide",
      "label": "Fantasy dashboard on desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View your fantasy dashboard",
      "url": "/",
      "icons": [{ "src": "/icons/favicon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Leagues",
      "short_name": "Leagues",
      "description": "Manage your leagues",
      "url": "/leagues",
      "icons": [{ "src": "/icons/favicon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Game Center",
      "short_name": "Game Center",
      "description": "Live game scores and stats",
      "url": "/gamecenter",
      "icons": [{ "src": "/icons/favicon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Profile",
      "short_name": "Profile",
      "description": "View and edit your profile",
      "url": "/profile", 
      "icons": [{ "src": "/icons/favicon-96x96.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}