rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to extract league ID from lineup document ID
    // Lineup ID format: {leagueId}_{season}_{week}
    function extractLeagueIdFromLineupId(lineupId) {
      return lineupId.split('_')[0];
    }

    // Helper function to check if a user is a member of a specific league
    function isLeagueMember(userId, leagueId) {
      return exists(/databases/$(database)/documents/leagues/$(leagueId)) &&
        userId in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
    }

    // Helper function to extract league ID from weekly tips document ID
    // Weekly tips ID format: {leagueId}_week_{week}_season_{season}
    function extractLeagueIdFromTipsId(tipsId) {
      return tipsId.split('_')[0];
    }

    // --- User Data ---
    // Allow authenticated users to read basic profile info (for leaderboards)
    // but only allow users to write to their own profile
    match /users/{uid} {
      allow read: if request.auth != null; // Allow reading firstName, lastName for leaderboards
      allow write: if request.auth != null && request.auth.uid == uid; // Only own profile writes
    }

    // Rules for user-specific subcollections (like weeklyLineups)
    match /users/{uid}/{collectionId}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow league members to read each other's weekly lineups for standings calculation
    match /users/{uid}/weeklyLineups/{lineupId} {
      allow read: if request.auth != null && 
        // User can read their own lineups
        (request.auth.uid == uid ||
        // Or user can read lineups from leagues they're a member of
        isLeagueMember(request.auth.uid, extractLeagueIdFromLineupId(lineupId)));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow user to read/write their usageCounts documents within leagueUsage
    match /users/{uid}/leagueUsage/{leagueSeasonDocId}/usageCounts/{usageItemDocId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- League Data ---
    // Allow authenticated users to read league data
    match /leagues/{leagueId} {
      allow get, list: if request.auth != null;
      // Writes to leagues (create, update, delete) are complex and often handled by Cloud Functions.
      // If direct admin writes are needed and secured by admin claim:
      // allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
      allow create, update, delete: if false; // Kept as per your original rule for direct client writes
    }

    // --- Weekly Tips Feature ---
    // Weekly tips polls - league members can read, only functions can write
    match /weeklyTips/{tipsId} {
      allow read: if request.auth != null && 
        isLeagueMember(request.auth.uid, extractLeagueIdFromTipsId(tipsId));
      allow create, update, delete: if false; // Only functions should manage tips polls
    }

    // User tips within a weekly tips poll
    match /weeklyTips/{tipsId}/userTips/{userId} {
      allow read: if request.auth != null && 
        isLeagueMember(request.auth.uid, extractLeagueIdFromTipsId(tipsId));
      allow write: if request.auth != null && 
        request.auth.uid == userId && 
        isLeagueMember(request.auth.uid, extractLeagueIdFromTipsId(tipsId));
    }

    // Prophet standings - league members can read, only functions can write
    match /prophetStandings/{standingsId} {
      allow read: if request.auth != null && 
        isLeagueMember(request.auth.uid, extractLeagueIdFromTipsId(standingsId));
      allow create, update, delete: if false; // Only functions should manage standings
    }

    // --- Core Game Data ---
    // NFL Players Data (used for lineup selection)
    match /nfl_players/{playerId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false; // Only backend/functions should write
    }

    // Player Data & Stats
    match /players/{playerId} {
      allow get, list: if request.auth != null;
      // Direct writes to player root documents by admin (if needed, e.g. manual correction):
      // allow write: if request.auth != null && request.auth.token.admin == true;
      allow create, update, delete: if false; // Kept as per your original rule for direct client writes
    }
    // NEW: Admins can write to player game stats for mock data
    match /players/{playerId}/gamestats/{gameId} {
      allow read: if request.auth != null; // All auth users can read (e.g., for GameStatsModal)
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Team Data & Stats
    match /teams/{teamId} {
      allow get, list: if request.auth != null;
      // Direct writes to team root documents by admin (if needed):
      // allow write: if request.auth != null && request.auth.token.admin == true;
      allow create, update, delete: if false; // Kept as per your original rule for direct client writes
    }
    // NEW: Admins can write to team game stats for mock data
    match /teams/{teamId}/gamestats/{gameId} {
      allow read: if request.auth != null; // All auth users can read
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // NFL Schedules
    match /nfl_schedules/{scheduleId} {
      allow get, list: if request.auth != null;
      // MODIFIED: Admins can create, update, delete schedules (e.g., for editing game times in mock tool)
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Allow authenticated users to read game scores
    match /gameScores/{gameId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false; // Only backend/functions should write
    }

    // --- API Cache ---
    // Assuming apiCache is read by clients, written by backend
    match /apiCache/{docId} {
       allow read: if request.auth != null; // Changed from 'if true' for slight security improvement
       allow write: if false; // Only backend/functions should write here
    }
  }
} 